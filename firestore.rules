rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // each user can only read and write their own scan history
    match /users/{userId}/scans/{scanId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // signed in users can read every report and add their own, nobody can edit or delete one
    match /reports/{reportId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['domain', 'url', 'type', 'category', 'reporterId', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.domain is string
        && request.resource.data.domain.size() > 0
        && request.resource.data.domain.size() < 254
        && request.resource.data.createdAt == request.time
        && reportId == request.auth.uid + '_' + request.resource.data.domain;

      allow update, delete: if false;
    }
  }
}
